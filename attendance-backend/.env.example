# ==============================================================================
# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
# ==============================================================================
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/attendance_system

# ==============================================================================
# JWT Authentication
# Generate a secure key using: openssl rand -hex 32
# ==============================================================================
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==============================================================================
# AI / LLM & IoT Device Keys
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
DEVICE_API_KEY=your_attendance_device_secret_api_key_here
